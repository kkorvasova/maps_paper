	keywords = {Neuroscience, REM sleep},
	pages = {6896},
	annote = {Number: 1},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/ACLAH577/Wang et al. - 2022 - REM sleep is associated with distinct global corti.pdf:application/pdf},
}

@article{kim_three_2015-3,
	title = {Three {Types} of {Cortical} {Layer} 5 {Neurons} {That} {Differ} in {Brain}-wide {Connectivity} and {Function}},
