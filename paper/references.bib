	pages = {218--229},
	file = {Sato, Nauhaus, Carandini - 2012 - Traveling Waves in Visual Cortex:/Users/karolina/Zotero/storage/BBGQTI2A/Sato, Nauhaus, Carandini - 2012 - Traveling Waves in Visual Cortex.pdf:application/pdf},
}

