	keywords = {Network models, Consolidation, Long-term memory, Psychology},
	pages = {1438--1448},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/SUQL6BIX/Sun et al. - 2023 - Organizing memories for generalization in compleme.pdf:application/pdf},
}

@article{el_oussini_ca3_2023,
	title = {{CA3} hippocampal synaptic plasticity supports ripple physiology during memory consolidation},
	volume = {14},
