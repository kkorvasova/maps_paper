	file = {Bartos, Vida, Jonas - 2007 - Synaptic mechanisms of synchronized gamma oscillations in inhibitory interneuron networks(2):/Users/karolina/Zotero/storage/8NPVJRVN/Bartos, Vida, Jonas - 2007 - Synaptic mechanisms of synchronized gamma oscillations in inhibitory interneuron networks(2).pdf:application/pdf},
