	journal = {Scientific Data},
	author = {Boran, Ece and Fedele, Tommaso and Steiner, Adrian and Hilfiker, Peter and Stieglitz, Lennart and Grunwald, Thomas and Sarnthein, Johannes},
	month = jan,
