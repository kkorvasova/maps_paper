@article{mazo_long-range_2022-6,
	title = {Long-range {GABAergic} projections contribute to cortical feedback control of sensory processing},
	volume = {13},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-022-34513-0},
	doi = {10.1038/s41467-022-34513-0},
	abstract = {In the olfactory system, the olfactory cortex sends glutamatergic projections back to the first stage of olfactory processing, the olfactory bulb (OB). Such corticofugal excitatory circuits — a canonical circuit motif described in all sensory systems— dynamically adjust early sensory processing. Here, we uncover a corticofugal inhibitory feedback to OB, originating from a subpopulation of GABAergic neurons in the anterior olfactory cortex and innervating both local and output OB neurons. In vivo imaging and network modeling showed that optogenetic activation of cortical GABAergic projections drives a net subtractive inhibition of both spontaneous and odor-evoked activity in local as well as output neurons. In output neurons, stimulation of cortical GABAergic feedback enhances separation of population odor responses in tufted cells, but not mitral cells. Targeted pharmacogenetic silencing of cortical GABAergic axon terminals impaired discrimination of similar odor mixtures. Thus, corticofugal GABAergic projections represent an additional circuit motif in cortical feedback control of sensory processing.},
	number = {1},
	urldate = {2023-05-18},
	journal = {Nature Communications},
	publisher = {Nature Publishing Group},
	author = {Mazo, Camille and Nissant, Antoine and Saha, Soham and Peroni, Enzo and Lledo, Pierre-Marie and Lepousez, Gabriel},
	month = nov,
	year = {2022},
	keywords = {Neural circuits, Olfactory bulb, Sensory processing},
	pages = {6879},
	annote = {Number: 1},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/9SCILA9B/Mazo et al. - 2022 - Long-range GABAergic projections contribute to cor.pdf:application/pdf},
}

@article{brookes_magnetoencephalography_2022-3,
	title = {Magnetoencephalography with optically pumped magnetometers ({OPM}-{MEG}): the next generation of functional neuroimaging},
	volume = {45},
	issn = {0166-2236},
	shorttitle = {Magnetoencephalography with optically pumped magnetometers ({OPM}-{MEG})},
	url = {https://www.sciencedirect.com/science/article/pii/S0166223622001023},
	doi = {10.1016/j.tins.2022.05.008},
	abstract = {Magnetoencephalography (MEG) measures human brain function via assessment of the magnetic fields generated by electrical activity in neurons. Despite providing high-quality spatiotemporal maps of electrophysiological activity, current MEG instrumentation is limited by cumbersome field sensing technologies, resulting in major barriers to utility. Here, we review a new generation of MEG technology that is beginning to lift many of these barriers. By exploiting quantum sensors, known as optically pumped magnetometers (OPMs), ‘OPM-MEG’ has the potential to dramatically outperform the current state of the art, promising enhanced data quality (better sensitivity and spatial resolution), adaptability to any head size/shape (from babies to adults), motion robustness (participants can move freely during scanning), and a less complex imaging platform (without reliance on cryogenics). We discuss the current state of this emerging technique and describe its far-reaching implications for neuroscience.},
	number = {8},
	urldate = {2024-07-02},
	journal = {Trends in Neurosciences},
	author = {Brookes, Matthew J. and Leggett, James and Rea, Molly and Hill, Ryan M. and Holmes, Niall and Boto, Elena and Bowtell, Richard},
	month = aug,
	year = {2022},
	keywords = {biomagnetism, electrophysiology, functional brain imaging, neurophysiology, OPM-MEG, quantum technology},
	pages = {621--634},
	file = {Full Text:/Users/karolina/Zotero/storage/CNY8K4LK/Brookes et al. - 2022 - Magnetoencephalography with optically pumped magne.pdf:application/pdf;ScienceDirect Snapshot:/Users/karolina/Zotero/storage/5XCIL5S2/S0166223622001023.html:text/html},
}

