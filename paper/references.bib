@article{frien_stimulus-specific_1994,
	title = {Stimulus-specific fast oscillations at zero phase between visual areas {V1} and {V2} of awake monkey},
	volume = {5},
	issn = {0959-4965},
	url = {https://journals.lww.com/neuroreport/abstract/1994/11000/stimulus_specific_fast_oscillations_at_zero_phase.17.aspx},
	abstract = {Synchronization of fast cortical oscillations (35–90 Hz) has been proposed as a basis of sensory integration. This hypothesis requires stimulus specific oscillations that occur synchronously in different cortical areas of awake animals. Here, we demonstrate the presence of, and phaselocking between, high amplitude stimulus specific oscillations (50–90 Hz) in striate (V1) and extra striate (V2) visual cortex of an awake monkey. Oscillations of multiple unit spikes and local field potentials occurred with an average V1–V2 phase difference near zero. This finding was unexpected because V1 and V2 are thought to be serially arranged in the primate's visual processing stream. However, near zero-phase synchronization among cortical areas might enable fast and effective communication via the many reciprocal cortico–cortical connections for processes such as sensory integration.},
	language = {en-US},
	number = {17},
	urldate = {2025-12-10},
	journal = {NeuroReport},
	author = {Frien, Axel and Eckhorn, Reinhard and Bauer, Roman and Woelbern, Thomas and Kehr, Harald},
	month = nov,
	year = {1994},
	pages = {2273},
	file = {Snapshot:/Users/karolina/Zotero/storage/E7JJ4HMZ/stimulus_specific_fast_oscillations_at_zero_phase.17.html:text/html},
}

@article{engel_interhemispheric_1991,
	title = {Interhemispheric {Synchronization} of {Oscillatory} {Neuronal} {Responses} in {Cat} {Visual} {Cortex}},
	volume = {252},
	url = {https://www.science.org/doi/10.1126/science.252.5009.1177},
	doi = {10.1126/science.252.5009.1177},
	abstract = {Neurons in area 17 of cat visual cortex display oscillatory responses that can synchronize across spatially separate columns in a stimulus-specific way. Response synchronization has now been shown to occur also between neurons in area 17 of the right and left cerebral hemispheres. This synchronization was abolished by section of the corpus callosum. Thus, the response synchronization is mediated by corticocortical connections. These data are compatible with the hypothesis that temporal synchrony of neuronal discharges serves to bind features within and between the visual hemifields.},
