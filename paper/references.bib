}

@article{scholvinck_influence_2012-3,
	title = {The influence of spontaneous activity on stimulus processing in primary visual cortex},
	volume = {59},
	issn = {1053-8119},
	url = {https://www.sciencedirect.com/science/article/pii/S1053811911012304},
	doi = {10.1016/j.neuroimage.2011.10.066},
	abstract = {Spontaneous activity in the resting human brain has been studied extensively; however, how such activity affects the local processing of a sensory stimulus is relatively unknown. Here, we examined the impact of spontaneous activity in primary visual cortex on neuronal and behavioural responses to a simple visual stimulus, using functional MRI. Stimulus-evoked responses remained essentially unchanged by spontaneous fluctuations, combining with them in a largely linear fashion (i.e., with little evidence for an interaction). However, interactions between spontaneous fluctuations and stimulus-evoked responses were evident behaviourally; high levels of spontaneous activity tended to be associated with increased stimulus detection at perceptual threshold. Our results extend those found in studies of spontaneous fluctuations in motor cortex and higher order visual areas, and suggest a fundamental role for spontaneous activity in stimulus processing.},
	number = {3},
	urldate = {2023-01-20},
	journal = {NeuroImage},
	author = {Schölvinck, M. L. and Friston, K. J. and Rees, G.},
	month = feb,
	year = {2012},
	keywords = {fMRI, Primary visual cortex, Psycho-physiological interaction, Resting-state functional connectivity, Spontaneous activity},
	pages = {2700--2708},
	file = {ScienceDirect Full Text PDF:/Users/karolina/Zotero/storage/I4FHNL9A/Schölvinck et al. - 2012 - The influence of spontaneous activity on stimulus .pdf:application/pdf;ScienceDirect Snapshot:/Users/karolina/Zotero/storage/BSQUI537/S1053811911012304.html:text/html},
}

@article{tavazzi_neuroplasticity_2021-4,
	title = {Neuroplasticity and {Motor} {Rehabilitation} in {Multiple} {Sclerosis}: {A} {Systematic} {Review} on {MRI} {Markers} of {Functional} and {Structural} {Changes}},
	volume = {15},
	issn = {1662-453X},
	shorttitle = {Neuroplasticity and {Motor} {Rehabilitation} in {Multiple} {Sclerosis}},
	url = {https://www.frontiersin.org/articles/10.3389/fnins.2021.707675/full},
	doi = {10.3389/fnins.2021.707675},
	abstract = {Background: Motor rehabilitation is routinely used in clinical practice as an effective method to reduce progressive disability gain in multiple sclerosis (MS), but rehabilitation approaches are typically unstandardized, and only few studies have investigated the impact of rehabilitation on brain neuroplasticity. Objective: To summarize and critically analyze studies applying MRI markers of functional connectivity and structural changes to assess the effect of motor rehabilitation on brain neuroplasticity in MS. Methods: Literature search was performed using PubMed and EMBASE, selecting studies having as a subject motor rehabilitation and advanced MRI techniques investigating neuroplasticity in adult patients affected by MS. Results: Seventeen out of 798 papers were selected, of which 5 applied structural MRI (4 diffusion tensor imaging, 1 volumetric measurements), 7 applied functional fMRI (5 task-related fMRI, 2 resting-state fMRI) whereas the remaining 5 applied both structural and functional imaging. Discussion: The considerable data heterogeneity and the small sample sizes characterizing the studies limit interpretation and generalization of the results. Overall, motor rehabilitation promotes clinical improvement, paralleled by positive adaptive brain changes, whose features and extent depend upon different variables, including the type of rehabilitation approach. MRI markers of functional and structural connectivity should be implemented in studies testing the efficacy of motor rehabilitation. They allow for a better understanding of neuroplastic mechanisms underlying rehabilitation-mediated clinical achievements, facilitating the identification of rehabilitation strategies tailored to patients' needs and abilities.},
	urldate = {2026-07-17},
	journal = {Frontiers in Neuroscience},
	author = {Tavazzi, Eleonora and Cazzoli, Marta and Pirastru, Alice and Blasi, Valeria and Rovaris, Marco and Bergsland, Niels and Baglio, Francesca},
	month = oct,
	year = {2021},
	pages = {707675},
	file = {Full Text:/Users/karolina/Zotero/storage/NHQRTRVI/Tavazzi et al. - 2021 - Neuroplasticity and Motor Rehabilitation in Multiple Sclerosis A Systematic Review on MRI Markers o.pdf:application/pdf},
}

@article{hardstone_frequency-specific_2022-3,
	title = {Frequency-specific neural signatures of perceptual content and perceptual stability},
	volume = {11},
	issn = {2050-084X},
	url = {https://doi.org/10.7554/eLife.78108},
	doi = {10.7554/eLife.78108},
	abstract = {In the natural environment, we often form stable perceptual experiences from ambiguous and fleeting sensory inputs. Which neural activity underlies the content of perception and which neural activity supports perceptual stability remains an open question. We used a bistable perception paradigm involving ambiguous images to behaviorally dissociate perceptual content from perceptual stability, and magnetoencephalography to measure whole-brain neural dynamics in humans. Combining multivariate decoding and neural state-space analyses, we found frequency-band-specific neural signatures that underlie the content of perception and promote perceptual stability, respectively. Across different types of images, non-oscillatory neural activity in the slow cortical potential ({\textbackslash}textbackslashtextless5 Hz) range supported the content of perception. Perceptual stability was additionally influenced by the amplitude of alpha and beta oscillations. In addition, neural activity underlying perceptual memory, which supports perceptual stability when sensory input is temporally removed from view, also encodes elapsed time. Together, these results reveal distinct neural mechanisms that support the content versus stability of visual perception.},
	urldate = {2023-01-19},
	journal = {eLife},
	publisher = {eLife Sciences Publications, Ltd},
	author = {Hardstone, Richard and Flounders, Matthew W and Zhu, Michael and He, Biyu J},
	editor = {Luo, Huan and Baker, Chris I},
	month = sep,
	year = {2022},
	keywords = {bistable perception, brain oscillations, magnetoencephalography, multivariate analysis, perceptual stability, slow cortical potential},
	pages = {e78108},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/S9MP22C4/Hardstone et al. - 2022 - Frequency-specific neural signatures of perceptual.pdf:application/pdf},
}

