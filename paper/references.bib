	file = {Full Text PDF:/Users/karolina/Zotero/storage/BEK2AXQE/Cai et al. - 2005 - Architectural and synaptic mechanisms underlying c.pdf:application/pdf},
}

@article{el_oussini_ca3_2023-6,
	title = {{CA3} hippocampal synaptic plasticity supports ripple physiology during memory consolidation},
