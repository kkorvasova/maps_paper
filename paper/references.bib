@article{veith_cholinergic_2021-6,
	title = {Cholinergic manipulations affect sensory responses but not attentional enhancement in macaque {MT}},
	volume = {19},
	issn = {1741-7007},
	url = {https://doi.org/10.1186/s12915-021-00993-7},
