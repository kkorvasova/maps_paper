	file = {Najafian et al. - 2022 - A theory of cortical map formation in the visual b.pdf:/Users/karolina/Zotero/storage/SPRPSSZB/Najafian et al. - 2022 - A theory of cortical map formation in the visual b.pdf:application/pdf},
}

@article{histed_direct_2009-3,
	title = {Direct {Activation} of {Sparse}, {Distributed} {Populations} of {Cortical} {Neurons} by {Electrical} {Microstimulation}},
	volume = {63},
