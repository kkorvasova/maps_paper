	keywords = {Computational neuroscience, Computational science, Neuroscience, Scientific data},
	pages = {2332},
	annote = {Number: 1},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/JA8K7WK7/Smith et al. - 2021 - How neurons exploit fractal geometry to optimize t.pdf:application/pdf;Snapshot:/Users/karolina/Zotero/storage/495ZTVTC/s41598-021-81421-2.html:text/html},
}

