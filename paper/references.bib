	pages = {365--370},
	file = {Shichino et al. - 1998 - Effects of inhalation anaesthetics on the release .pdf:/Users/karolina/Zotero/storage/49SNDMC2/Shichino et al. - 1998 - Effects of inhalation anaesthetics on the release .pdf:application/pdf},
}

@article{roca_fractal-based_2018-3,
	title = {Fractal-based techniques for physiological time series: {An} updated approach},
	volume = {16},
	url = {https://doi.org/10.1515/phys-2018-0093},
	doi = {10.1515/phys-2018-0093},
	abstract = {Along this paper, we shall update the state-of-the-art concerning the application of fractal-based techniques to test for fractal patterns in physiological time series. As such, the first half of the present work deals with some selected approaches to deal with the calculation of the self-similarity exponent of time series. They include broadly-used procedures as well as recent advances improving their accuracy and performance for a wide range of self-similar processes. The second part of this paper consists of a detailed review of high-quality studies carried out in the context of electroencephalogram signals. Both medical and non-medical applications have been deeply reviewed. This work is especially recommended to all those researchers especially interested in fractal pattern recognition for physiological time series.},
	number = {1},
	journal = {Open Physics},
	publisher = {De Gruyter},
	author = {Roca, José Luis and Rodríguez-Bermúdez, German and Fernández-Martínez, Manuel},
	month = jan,
	year = {2018},
	keywords = {electroencephalogram, fractal pattern, Hurst exponent, physiological time series, self-similar process},
	pages = {741--750},
