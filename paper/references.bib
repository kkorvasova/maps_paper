	annote = {Number: 1},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/N6MFQK83/Nitzan et al. - 2020 - Propagation of hippocampal ripples to the neocorte.pdf:application/pdf},
}

@article{girardeau_brain_2021-2,
