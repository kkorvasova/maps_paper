	journal = {Journal of Psychiatric Research},
	author = {Labiano-Fontcuberta, Andrés and Aladro, Yolanda and Martínez-Ginés, Mª Luisa and Ayuso, Lucía and Mitchell, Alex J. and Puertas, Verónica and Cerezo, Marta and Higueras, Yolanda and Benito-León, Julián},
	month = sep,
	year = {2015},
	keywords = {Depression, Anxious depression, Clinically isolated syndrome, Health-related quality of life, Psychiatric, Radiologically isolated syndrome},
	pages = {309--315},
	file = {ScienceDirect Snapshot:/Users/karolina/Zotero/storage/4MDMVBQ4/S0022395615001491.html:text/html},
}

