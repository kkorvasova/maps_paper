	keywords = {Biological Sciences, Ethology, Mathematical Biosciences, Zoology},
	pages = {102407},
	file = {ScienceDirect Full Text PDF:/Users/karolina/Zotero/storage/2NT39XA5/Goyal et al. - 2021 - Bumblebees land rapidly and robustly using a sophi.pdf:application/pdf;ScienceDirect Snapshot:/Users/karolina/Zotero/storage/6K9DXC45/S2589004221003758.html:text/html},
