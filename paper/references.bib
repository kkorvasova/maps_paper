	year = {2022},
	keywords = {Long-term memory, Visual system},
	pages = {5864},
	annote = {Number: 1},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/2QHVR8GZ/Favila et al. - 2022 - Perception and memory have distinct spatial tuning.pdf:application/pdf},
}

@article{iwata_hippocampal_2024-3,
	title = {Hippocampal sharp-wave ripples correlate with periods of naturally occurring self-generated thoughts in humans},
