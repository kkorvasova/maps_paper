	pages = {29--39},
	file = {ScienceDirect Full Text PDF:/Users/karolina/Zotero/storage/L42MDMCR/Nagayama et al. - 2022 - Detecting cell assemblies by NMF-based clustering .pdf:application/pdf;ScienceDirect Snapshot:/Users/karolina/Zotero/storage/FBYS6PHS/S0893608022000338.html:text/html},
}

@article{palm_towards_1981,
