	keywords = {Animals, Cerebral Cortex, Clinical Trials as Topic, Humans, Multiple Sclerosis},
	pages = {1082--1092},
	file = {Submitted Version:/Users/karolina/Zotero/storage/UUEN5P7A/Geurts et al. - 2012 - Measurement and clinical effect of grey matter pathology in multiple sclerosis.pdf:application/pdf},
}

@article{manasova_dynamics_2025-1,
	title = {Dynamics of {EEG} {Microstates} {Change} {Across} the {Spectrum} of {Disorders} of {Consciousness}},
	volume = {38},
	issn = {1573-6792},
	url = {https://doi.org/10.1007/s10548-025-01142-x},
	doi = {10.1007/s10548-025-01142-x},
	abstract = {As a response to the environment and internal signals, brain networks reorganize on a sub-second scale. To capture this reorganization in patients with disorders of consciousness (DoC) and understand their residual brain activity, we investigated the dynamics of electroencephalography (EEG) microstates. EEG microstates are meta-stable topographies that last tens to a few hundreds of milliseconds and are hypothesized to reflect large-scale cortical networks. To obtain EEG‑microstate segmentation, EEG topographies per sample were clustered into four groups for the purpose of the present comparison with the existing four‑class literature. We then obtained a time series of maps with different frequencies of occurrence and duration. One such occurrence of a map with a given duration is called a microstate. The goal of this work was to study the static and dynamic properties of these topographical patterns in DoC patients. Using the microstate time series, we calculated static and dynamic markers. In contrast to the static, the dynamic metrics depend on the specific temporal sequences of the maps. The static measure map coverage showed differences between healthy controls and patients. In contrast, some dynamic markers captured inter-patient group differences. The dynamic markers we investigated are Mean Microstate Durations (MMD), Microstate Duration Variances (MDV), Microstate Transition Matrices (MTM), and Entropy Production (EP). The MMD and MDV decreased with the state of consciousness, whereas the MTM non-diagonal transitions and EP increased. In other words, DoC patients had slower and closer to equilibrium (time-reversible) brain dynamics. In conclusion, static and dynamic EEG microstate metrics differed across consciousness levels, with the latter having captured the subtler differences between groups of patients with DoC.},
	language = {en},
	number = {6},
	urldate = {2026-05-04},
	journal = {Brain Topography},
	author = {Manasova, Dragana and Perl, Yonatan Sanz and Bruno, Nicolas Marcelo and Valente, Melanie and Rohaut, Benjamin and Tagliazucchi, Enzo and Naccache, Lionel and Raimondo, Federico and Sitt, Jacobo D.},
	month = sep,
	year = {2025},
	keywords = {Disorders of consciousness, Dynamics, EEG microstates, Entropy production},
	pages = {65},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/DF3UJCT4/Manasova et al. - 2025 - Dynamics of EEG Microstates Change Across the Spectrum of Disorders of Consciousness.pdf:application/pdf},
}

