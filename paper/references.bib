	annote = {Number: 1},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/LBSS4SBD/Smith et al. - 2021 - How neurons exploit fractal geometry to optimize t.pdf:application/pdf;Snapshot:/Users/karolina/Zotero/storage/GTKS7AX7/s41598-021-81421-2.html:text/html},
