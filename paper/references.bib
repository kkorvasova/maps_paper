	volume = {19},
	issn = {1546-1726},
	url = {https://www.nature.com/articles/nn.4304},
	doi = {10.1038/nn.4304},
	abstract = {The authors show that artificially enhancing the temporal coordination between hippocampal sharp wave-ripples and cortical delta waves and spindles leads to the reorganization of cortical networks, an increase in their responsivity during recall, and memory consolidation. The study provides causal evidence for the role of hippocampo-cortical interactions during sleep in memory consolidation.},
	number = {7},
	urldate = {2023-10-02},
