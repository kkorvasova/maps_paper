	pages = {15404},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/8QY3NKLY/Schönauer et al. - 2017 - Decoding material-specific memory reprocessing dur.pdf:application/pdf},
}

@article{iwata_hippocampal_2024,
	title = {Hippocampal sharp-wave ripples correlate with periods of naturally occurring self-generated thoughts in humans},
