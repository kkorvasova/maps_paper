	file = {Full Text PDF:/Users/karolina/Zotero/storage/TKC9ZN33/Lenne et al. - 2013 - Decrease of Mutual Information in Brain Electrical Activity of Patients with Relapsing-Remitting Mul.pdf:application/pdf;Snapshot:/Users/karolina/Zotero/storage/5S9NPSTR/BEN-120278.html:text/html},
