@misc{noauthor_artificial_nodate-6,
	title = {Artificial {Vision} for the {Blind}: {Electrical} {Stimulation} of {Visual} {Cortex} {Offers} {Hope} for a {Functional} {Prosthesis} {\textbackslash}textbackslashtextbar {Science}},
