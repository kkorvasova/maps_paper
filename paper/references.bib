@article{dumoulin_bridi_rapid_2015-1,
	title = {Rapid eye movement sleep promotes cortical plasticity in the developing brain},
	volume = {1},
	url = {https://www.science.org/doi/10.1126/sciadv.1500105},
	doi = {10.1126/sciadv.1500105},
	abstract = {Rapid eye movement sleep is maximal during early life, but its function in the developing brain is unknown. We investigated the role of rapid eye movement sleep in a canonical model of developmental plasticity in vivo (ocular dominance plasticity in the cat) induced by monocular deprivation. Preventing rapid eye movement sleep after monocular deprivation reduced ocular dominance plasticity and inhibited activation of a kinase critical for this plasticity (extracellular signal–regulated kinase). Chronic single-neuron recording in freely behaving cats further revealed that cortical activity during rapid eye movement sleep resembled activity present during monocular deprivation. This corresponded to times of maximal extracellular signal–regulated kinase activation. These findings indicate that rapid eye movement sleep promotes molecular and network adaptations that consolidate waking experience in the developing brain.},
	number = {6},
	urldate = {2023-01-23},
	journal = {Science Advances},
	publisher = {American Association for the Advancement of Science},
	author = {Dumoulin Bridi, Michelle C. and Aton, Sara J. and Seibt, Julie and Renouard, Leslie and Coleman, Tammi and Frank, Marcos G.},
	month = jul,
	year = {2015},
	pages = {e1500105},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/F2368RRZ/Dumoulin Bridi et al. - 2015 - Rapid eye movement sleep promotes cortical plastic.pdf:application/pdf},
}

@article{renouard_rem_2022-1,
	title = {{REM} sleep promotes bidirectional plasticity in developing visual cortex in vivo},
	volume = {12},
	issn = {2451-9944},
	url = {https://www.sciencedirect.com/science/article/pii/S2451994422000025},
	doi = {10.1016/j.nbscr.2022.100076},
	abstract = {Sleep is required for the full expression of plasticity during the visual critical period (CP). However, the precise role of rapid-eye-movement (REM) sleep in this process is undetermined. Previous studies in rodents indicate that REM sleep weakens cortical circuits following MD, but this has been explored in only one class of cortical neuron (layer 5 apical dendrites). We investigated the role of REM sleep in ocular dominance plasticity (ODP) in layer 2/3 neurons using 2-photon calcium imaging in awake CP mice. In contrast to findings in layer 5 neurons, we find that REM sleep promotes changes consistent with synaptic strengthening and weakening. This supports recent suggestions that the effects of sleep on plasticity are highly dependent upon the type of circuit and preceding waking experience.},
	urldate = {2023-01-23},
	journal = {Neurobiology of Sleep and Circadian Rhythms},
	author = {Renouard, Leslie and Hayworth, Christopher and Rempe, Michael and Clegern, Will and Wisor, Jonathan and Frank, Marcos G.},
	month = may,
	year = {2022},
	keywords = {Development, Monocular deprivation, Ocular dominance plasticity, Ontogeny, Remodeling, Synapse},
	pages = {100076},
	file = {ScienceDirect Full Text PDF:/Users/karolina/Zotero/storage/BXAL6YKM/Renouard et al. - 2022 - REM sleep promotes bidirectional plasticity in dev.pdf:application/pdf;ScienceDirect Snapshot:/Users/karolina/Zotero/storage/XG5KC6VQ/S2451994422000025.html:text/html},
}

@article{wang_rem_2022-1,
	title = {{REM} sleep is associated with distinct global cortical dynamics and controlled by occipital cortex},
	volume = {13},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-022-34720-9},
	doi = {10.1038/s41467-022-34720-9},
	abstract = {The cerebral cortex is spontaneously active during sleep, yet it is unclear how this global cortical activity is spatiotemporally organized, and whether such activity not only reflects sleep states but also contributes to sleep state switching. Here we report that cortex-wide calcium imaging in mice revealed distinct sleep stage-dependent spatiotemporal patterns of global cortical activity, and modulation of such patterns could regulate sleep state switching. In particular, elevated activation in the occipital cortical regions (including the retrosplenial cortex and visual areas) became dominant during rapid-eye-movement (REM) sleep. Furthermore, such pontogeniculooccipital (PGO) wave-like activity was associated with transitions to REM sleep, and optogenetic inhibition of occipital activity strongly promoted deep sleep by suppressing the NREM-to-REM transition. Thus, whereas subcortical networks are critical for initiating and maintaining sleep and wakefulness states, distinct global cortical activity also plays an active role in controlling sleep states.},
	number = {1},
	urldate = {2023-01-23},
	journal = {Nature Communications},
	publisher = {Nature Publishing Group},
	author = {Wang, Ziyue and Fei, Xiang and Liu, Xiaotong and Wang, Yanjie and Hu, Yue and Peng, Wanling and Wang, Ying-wei and Zhang, Siyu and Xu, Min},
	month = nov,
	year = {2022},
	keywords = {Neuroscience, REM sleep},
	pages = {6896},
	annote = {Number: 1},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/ZARP685Q/Wang et al. - 2022 - REM sleep is associated with distinct global corti.pdf:application/pdf},
}

@article{frank_sleep_2001-1,
	title = {Sleep {Enhances} {Plasticity} in the {Developing} {Visual} {Cortex}},
	volume = {30},
	issn = {0896-6273},
	url = {https://www.sciencedirect.com/science/article/pii/S0896627301002793},
	doi = {10.1016/S0896-6273(01)00279-3},
	abstract = {During a critical period of brain development, occluding the vision of one eye causes a rapid remodeling of the visual cortex and its inputs. Sleep has been linked to other processes thought to depend on synaptic remodeling, but a role for sleep in this form of cortical plasticity has not been demonstrated. We found that sleep enhanced the effects of a preceding period of monocular deprivation on visual cortical responses, but wakefulness in complete darkness did not do so. The enhancement of plasticity by sleep was at least as great as that produced by an equal amount of additional deprivation. These findings demonstrate that sleep and sleep loss modify experience-dependent cortical plasticity in vivo. They suggest that sleep in early life may play a crucial role in brain development.},
	number = {1},
	urldate = {2023-01-23},
	journal = {Neuron},
	author = {Frank, Marcos G and Issa, Naoum P and Stryker, Michael P},
	month = apr,
	year = {2001},
	pages = {275--287},
	file = {Full Text:/Users/karolina/Zotero/storage/LE8X7AT3/Frank et al. - 2001 - Sleep Enhances Plasticity in the Developing Visual.pdf:application/pdf;ScienceDirect Snapshot:/Users/karolina/Zotero/storage/5TZVK4ST/S0896627301002793.html:text/html},
}

@article{igawa_activation_2001-1,
	title = {Activation of visual cortex in {REM} sleep measured by 24-channel {NIRS} imaging},
	volume = {55},
	issn = {1440-1819},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1046/j.1440-1819.2001.00819.x},
	doi = {10.1046/j.1440-1819.2001.00819.x},
	abstract = {To visualize dreaming brain functions we studied hemodynamic changes in the visual cortex during the transition from non-rapid eye movement (NREM) to rapid eye movement (REM) sleep, using a 24-channel Near-Infrared Spectroscopy (NIRS) imaging method. Results were compared to the activation in visual cortex by visual stimulation during wakefulness. Subjects were four healthy males between 25 and 49 years of age. Five all-night polysomnographic and NIRS recordings were made. Increases in the oxygenated hemoglobin concentration in visual cortex were observed from nine of 14 REM periods. The activated areas were broader during REM sleep than during visual stimulation. These findings suggest that activation of visual cortex in REM sleep might represent dream-related brain activity.},
	number = {3},
	urldate = {2023-01-23},
	journal = {Psychiatry and Clinical Neurosciences},
	author = {Igawa, Mariko and Atsumi, Yoshikata and Takahashi, Kazumi and Shiotsuka, Shinichi and Hirasawa, Hideto and Yamamoto, Ryusei and Maki, Atsushi and Yamashita, Yuichi and Koizumi, Hideaki},
	year = {2001},
	keywords = {dreaming, EEG, mapping, NIRS, occipital, REM sleep, visual cortex},
	pages = {187--188},
	annote = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1046/j.1440-1819.2001.00819.x},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/5AZ4LM7X/Igawa et al. - 2001 - Activation of visual cortex in REM sleep measured .pdf:application/pdf;Snapshot:/Users/karolina/Zotero/storage/HBHQ6ZRH/j.1440-1819.2001.00819.html:text/html},
}

@article{frank_sleep_2017-1,
	series = {Neurobiology of {Sleep}},
	title = {Sleep and plasticity in the visual cortex: more than meets the eye},
	volume = {44},
	issn = {0959-4388},
	shorttitle = {Sleep and plasticity in the visual cortex},
	url = {https://www.sciencedirect.com/science/article/pii/S0959438816301738},
	doi = {10.1016/j.conb.2017.01.001},
	abstract = {The visual cortex has provided key insights into how experience shapes cortical circuitry. Scientists have identified how different manipulations of visual experience trigger distinct forms of plasticity as well as many of the underlying cellular and molecular mechanisms. Intriguingly, experience is not the only factor driving plasticity in the visual system. Sleep is also required for the full expression of plasticity in the developing visual cortex. In this review, I discuss what we have learned about the role of sleep in visual cortical plasticity and what it tells us about sleep function.},
	urldate = {2023-01-23},
	journal = {Current Opinion in Neurobiology},
	author = {Frank, Marcos G},
	month = jun,
	year = {2017},
	pages = {8--12},
	file = {ScienceDirect Full Text PDF:/Users/karolina/Zotero/storage/YWRLDDM2/Frank - 2017 - Sleep and plasticity in the visual cortex more th.pdf:application/pdf;ScienceDirect Snapshot:/Users/karolina/Zotero/storage/7444YEL9/S0959438816301738.html:text/html},
}

@article{eagleman_defensive_2021-1,
	title = {The {Defensive} {Activation} {Theory}: {REM} {Sleep} as a {Mechanism} to {Prevent} {Takeover} of the {Visual} {Cortex}},
	volume = {15},
	issn = {1662-453X},
	shorttitle = {The {Defensive} {Activation} {Theory}},
	url = {https://www.frontiersin.org/articles/10.3389/fnins.2021.632853},
	abstract = {Regions of the brain maintain their territory with continuous activity: if activity slows or stops (e.g., because of blindness), the territory tends to be taken over by its neighbors. A surprise in recent years has been the speed of takeover, which is measurable within an hour. These findings lead us to a new hypothesis on the origin of REM sleep. We hypothesize that the circuitry underlying REM sleep serves to amplify the visual system’s activity periodically throughout the night, allowing it to defend its territory against takeover from other senses. We find that measures of plasticity across 25 species of primates correlate positively with the proportion of rapid eye movement (REM) sleep. We further find that plasticity and REM sleep increase in lockstep with evolutionary recency to humans. Finally, our hypothesis is consistent with the decrease in REM sleep and parallel decrease in neuroplasticity with aging.},
	urldate = {2023-01-23},
	journal = {Frontiers in Neuroscience},
	author = {Eagleman, David M. and Vaughn, Don A.},
	year = {2021},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/WIYF5BUZ/Eagleman and Vaughn - 2021 - The Defensive Activation Theory REM Sleep as a Me.pdf:application/pdf},
}

@article{kirchberger_contextual_2023-1,
	title = {Contextual drive of neuronal responses in mouse {V1} in the absence of feedforward input},
	volume = {9},
	url = {https://www.science.org/doi/full/10.1126/sciadv.add2498},
	doi = {10.1126/sciadv.add2498},
	abstract = {Neurons in the primary visual cortex (V1) respond to stimuli in their receptive field (RF), which is defined by the feedforward input from the retina. However, V1 neurons are also sensitive to contextual information outside their RF, even if the RF itself is unstimulated. Here, we examined the cortical circuits for V1 contextual responses to gray disks superimposed on different backgrounds. Contextual responses began late and were strongest in the feedback-recipient layers of V1. They differed between the three main classes of inhibitory neurons, with particularly strong contextual drive of VIP neurons, indicating a contribution of disinhibitory circuits to contextual drive. Contextual drive was strongest when the gray disk was perceived as figure, occluding its background, rather than a hole. Our results link contextual drive in V1 to perceptual organization and provide previously unknown insight into how recurrent processing shapes the response of sensory neurons to facilitate figure perception.},
	number = {3},
	urldate = {2023-01-21},
	journal = {Science Advances},
	publisher = {American Association for the Advancement of Science},
	author = {Kirchberger, Lisa and Mukherjee, Sreedeep and Self, Matthew W. and Roelfsema, Pieter R.},
	month = jan,
	year = {2023},
	pages = {eadd2498},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/T2DWPIV6/Kirchberger et al. - 2023 - Contextual drive of neuronal responses in mouse V1.pdf:application/pdf},
}

@misc{jensen_gating_2023-1,
	title = {Gating by alpha band inhibition revised: a case for a secondary control mechanism},
	shorttitle = {Gating by alpha band inhibition revised},
	url = {https://psyarxiv.com/7bk32/},
	doi = {10.31234/osf.io/7bk32},
	abstract = {In recent decades there has been a growing interest in the role of neuronal oscillations in the alpha band and how they support cognition. It is clear from intracranial animal recordings, that alpha oscillations are associated with inhibition as increases in alpha power co-occur with a decrease in neuronal activity. Nevertheless, several findings have put into question whether alpha-band oscillations, in general, can be controlled in a top-down manner to suppress visual distractors. Also, it has been questioned whether alpha oscillations can exercise gain control in the early visual cortex. We here point to a revised mechanism in which alpha oscillations are controlled by a secondary mechanism governed by the load of goal-relevant information. This view is compatible with perceptual load theory and biased competition, where distractor suppression is an indirect consequence of engagement. We will outline how this framework can be further tested experimentally and discuss the consequences for network dynamics and resource allocation in the working brain.},
	urldate = {2023-01-21},
	publisher = {PsyArXiv},
	author = {Jensen, Ole},
	month = jan,
	year = {2023},
	keywords = {Cognitive Neuroscience, Neuroscience},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/XNJG5PWP/Jensen - 2023 - Gating by alpha band inhibition revised a case fo.pdf:application/pdf},
}

