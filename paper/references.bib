	volume = {9},
	issn = {2052-4463},
	url = {https://www.nature.com/articles/s41597-022-01180-1},
	doi = {10.1038/s41597-022-01180-1},
	abstract = {Co-variations in resting state activity are thought to arise from a variety of correlated inputs to neurons, such as bottom-up activity from lower areas, feedback from higher areas, recurrent processing in local circuits, and fluctuations in neuromodulatory systems. Most studies have examined resting state activity throughout the brain using MRI scans, or observed local co-variations in activity by recording from a small number of electrodes. We carried out electrophysiological recordings from over a thousand chronically implanted electrodes in the visual cortex of non-human primates, yielding a resting state dataset with unprecedentedly high channel counts and spatiotemporal resolution. Such signals could be used to observe brain waves across larger regions of cortex, offering a temporally detailed picture of brain activity. In this paper, we provide the dataset, describe the raw and processed data formats and data acquisition methods, and indicate how the data can be used to yield new insights into the ‘background’ activity that influences the processing of visual information in our brain.},
	number = {1},
	urldate = {2023-08-31},
	journal = {Scientific Data},
	publisher = {Nature Publishing Group},
	author = {Chen, Xing and Morales-Gregorio, Aitor and Sprenger, Julia and Kleinjohann, Alexander and Sridhar, Shashwat and van Albada, Sacha J. and Grün, Sonja and Roelfsema, Pieter R.},
	month = mar,
	year = {2022},
	keywords = {Extrastriate cortex, Neural decoding, Sensory processing, Striate cortex},
	pages = {77},
	annote = {Number: 1},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/J23HZTS9/Chen et al. - 2022 - 1024-channel electrophysiological recordings in ma.pdf:application/pdf},
}

@article{mazo_long-range_2022-3,
	title = {Long-range {GABAergic} projections contribute to cortical feedback control of sensory processing},
	volume = {13},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-022-34513-0},
	doi = {10.1038/s41467-022-34513-0},
	abstract = {In the olfactory system, the olfactory cortex sends glutamatergic projections back to the first stage of olfactory processing, the olfactory bulb (OB). Such corticofugal excitatory circuits — a canonical circuit motif described in all sensory systems— dynamically adjust early sensory processing. Here, we uncover a corticofugal inhibitory feedback to OB, originating from a subpopulation of GABAergic neurons in the anterior olfactory cortex and innervating both local and output OB neurons. In vivo imaging and network modeling showed that optogenetic activation of cortical GABAergic projections drives a net subtractive inhibition of both spontaneous and odor-evoked activity in local as well as output neurons. In output neurons, stimulation of cortical GABAergic feedback enhances separation of population odor responses in tufted cells, but not mitral cells. Targeted pharmacogenetic silencing of cortical GABAergic axon terminals impaired discrimination of similar odor mixtures. Thus, corticofugal GABAergic projections represent an additional circuit motif in cortical feedback control of sensory processing.},
	number = {1},
	urldate = {2023-05-18},
	journal = {Nature Communications},
	publisher = {Nature Publishing Group},
	author = {Mazo, Camille and Nissant, Antoine and Saha, Soham and Peroni, Enzo and Lledo, Pierre-Marie and Lepousez, Gabriel},
	month = nov,
	year = {2022},
	keywords = {Neural circuits, Olfactory bulb, Sensory processing},
	pages = {6879},
	annote = {Number: 1},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/WA7HBBVF/Mazo et al. - 2022 - Long-range GABAergic projections contribute to cor.pdf:application/pdf},
}

