	doi = {10.1038/s41597-020-0364-3},
	abstract = {We present an electrophysiological dataset recorded from nine subjects during a verbal working memory task. Subjects were epilepsy patients undergoing intracranial monitoring for the localization of epileptic seizures. Subjects performed a modified Sternberg task in which the encoding of memory items, maintenance, and recall were temporally separated. The dataset includes simultaneously recorded scalp EEG with the 10–20 system, intracranial EEG (iEEG) recorded with depth electrodes, waveforms and spike times of neurons recorded in the medial temporal lobe, and localization information on the depth electrodes. Subject characteristics and information on each trial (set size, match/mismatch, correct/incorrect, response, and response time) are given. For technical validation of data, we provide spike sorting quality metrics and the spectra of iEEG and scalp EEG signals. This dataset enables the investigation of working memory by providing simultaneous scalp EEG and iEEG recordings, which can be used for connectivity analysis, along with hard-to-obtain neuronal recordings from humans., Measurement(s)brain electrical activity • Working Memory • medial temporal lobe • neuronal action potentialTechnology Type(s)electroencephalography (EEG) • microelectrodeFactor Type(s)set size • match/mismatch • seizure onset zoneSample Characteristic - OrganismHomo sapiens , Machine-accessible metadata file describing the reported data: 10.6084/m9.figshare.11500485},
	urldate = {2026-09-03},
	journal = {Scientific Data},
	author = {Boran, Ece and Fedele, Tommaso and Steiner, Adrian and Hilfiker, Peter and Stieglitz, Lennart and Grunwald, Thomas and Sarnthein, Johannes},
	month = jan,
	year = {2020},
	pages = {30},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/WY6PIGTZ/Boran et al. - 2020 - Dataset of human medial temporal lobe neurons, scalp and intracranial EEG during a verbal working me.pdf:application/pdf},
}

@article{frank_sleep_2001-4,
	title = {Sleep {Enhances} {Plasticity} in the {Developing} {Visual} {Cortex}},
	volume = {30},
	issn = {0896-6273},
	url = {https://www.sciencedirect.com/science/article/pii/S0896627301002793},
	doi = {10.1016/S0896-6273(01)00279-3},
	abstract = {During a critical period of brain development, occluding the vision of one eye causes a rapid remodeling of the visual cortex and its inputs. Sleep has been linked to other processes thought to depend on synaptic remodeling, but a role for sleep in this form of cortical plasticity has not been demonstrated. We found that sleep enhanced the effects of a preceding period of monocular deprivation on visual cortical responses, but wakefulness in complete darkness did not do so. The enhancement of plasticity by sleep was at least as great as that produced by an equal amount of additional deprivation. These findings demonstrate that sleep and sleep loss modify experience-dependent cortical plasticity in vivo. They suggest that sleep in early life may play a crucial role in brain development.},
	number = {1},
	urldate = {2023-01-23},
	journal = {Neuron},
	author = {Frank, Marcos G and Issa, Naoum P and Stryker, Michael P},
	month = apr,
	year = {2001},
	pages = {275--287},
	file = {Full Text:/Users/karolina/Zotero/storage/4P4CKUQ8/Frank et al. - 2001 - Sleep Enhances Plasticity in the Developing Visual.pdf:application/pdf;ScienceDirect Snapshot:/Users/karolina/Zotero/storage/45MAVZL4/S0896627301002793.html:text/html},
}

@article{boran_dataset_2020-5,
	title = {Dataset of human medial temporal lobe neurons, scalp and intracranial {EEG} during a verbal working memory task},
	volume = {7},
	copyright = {2020 The Author(s)},
	issn = {2052-4463},
	url = {https://www.nature.com/articles/s41597-020-0364-3},
	doi = {10.1038/s41597-020-0364-3},
	abstract = {We present an electrophysiological dataset recorded from nine subjects during a verbal working memory task. Subjects were epilepsy patients undergoing intracranial monitoring for the localization of epileptic seizures. Subjects performed a modified Sternberg task in which the encoding of memory items, maintenance, and recall were temporally separated. The dataset includes simultaneously recorded scalp EEG with the 10–20 system, intracranial EEG (iEEG) recorded with depth electrodes, waveforms and spike times of neurons recorded in the medial temporal lobe, and localization information on the depth electrodes. Subject characteristics and information on each trial (set size, match/mismatch, correct/incorrect, response, and response time) are given. For technical validation of data, we provide spike sorting quality metrics and the spectra of iEEG and scalp EEG signals. This dataset enables the investigation of working memory by providing simultaneous scalp EEG and iEEG recordings, which can be used for connectivity analysis, along with hard-to-obtain neuronal recordings from humans.},
	language = {en},
	number = {1},
	urldate = {2026-09-03},
	journal = {Scientific Data},
	publisher = {Nature Publishing Group},
	author = {Boran, Ece and Fedele, Tommaso and Steiner, Adrian and Hilfiker, Peter and Stieglitz, Lennart and Grunwald, Thomas and Sarnthein, Johannes},
	month = jan,
	year = {2020},
	keywords = {Cognitive neuroscience, Electroencephalography – EEG, Hippocampus, Magnetic resonance imaging, Working memory},
	pages = {30},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/9G86SEG3/Boran et al. - 2020 - Dataset of human medial temporal lobe neurons, scalp and intracranial EEG during a verbal working me.pdf:application/pdf},
}

