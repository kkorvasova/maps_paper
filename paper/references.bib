	file = {Maturana et al. - 2020 - Critical slowing down as a biomarker for seizure susceptibility:/Users/karolina/Zotero/storage/N8U3XTDV/Maturana et al. - 2020 - Critical slowing down as a biomarker for seizure susceptibility.pdf:application/pdf},
