	pages = {2681--2695},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/42NWFYF3/Denker et al. - 2011 - The Local Field Potential Reflects Surplus Spike S.pdf:application/pdf;Snapshot:/Users/karolina/Zotero/storage/P38TRXFG/294276.html:text/html},
