@article{tamas_proximally_2000,
	title = {Proximally targeted {GABAergic} synapses and gap junctions synchronize cortical interneurons},
	volume = {3},
	url = {http://neurosci.nature.com},
	doi = {10.1038/73936},
	abstract = {Networks of GABAergic interneurons are implicated in synchronizing cortical activity at gamma frequencies (30-70 Hz). Here we demonstrate that the combined electrical and GABAergic synaptic coupling of basket cells instantaneously entrained gamma-frequency postsynaptic firing in layers 2/3 of rat somatosensory cortex. This entrainment was mediated by rapid curtailment of gap junctional coupling potentials by GABA(A) receptor- mediated IPSPs. Electron microscopy revealed spatial proximity of gap junctions and GABAergic synapses on somata and dendrites. Electrical coupling alone entrained postsynaptic firing with a phase lag, whereas unitary GABAergic connections were ineffective in gamma-frequency phasing. These observations demonstrate precise spatiotemporal mechanisms underlying action potential timing in oscillating interneuronal networks.},
	number = {4},
	journal = {Nature Neuroscience},
	publisher = {Nature Publishing Group},
	author = {Tamás, Gábor and Buhl, Eberhard H. and Lörincz, Andrea and Somogyi, Peter},
	month = apr,
	year = {2000},
	keywords = {Animal Genetics and Genomics, Behavioral Sciences, Biological Techniques, Biomedicine, general, Neurobiology, Neurosciences},
	pages = {366--371},
	file = {Tamás et al. - 2000 - Proximally targeted GABAergic synapses and gap junctions synchronize cortical interneurons:/Users/karolina/Zotero/storage/24TSEVYB/Tamás et al. - 2000 - Proximally targeted GABAergic synapses and gap junctions synchronize cortical interneurons.pdf:application/pdf},
}

