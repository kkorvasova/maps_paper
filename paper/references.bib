@article{dumoulin_bridi_rapid_2015,
	title = {Rapid eye movement sleep promotes cortical plasticity in the developing brain},
	volume = {1},
	url = {https://www.science.org/doi/10.1126/sciadv.1500105},
	doi = {10.1126/sciadv.1500105},
	abstract = {Rapid eye movement sleep is maximal during early life, but its function in the developing brain is unknown. We investigated the role of rapid eye movement sleep in a canonical model of developmental plasticity in vivo (ocular dominance plasticity in the cat) induced by monocular deprivation. Preventing rapid eye movement sleep after monocular deprivation reduced ocular dominance plasticity and inhibited activation of a kinase critical for this plasticity (extracellular signal–regulated kinase). Chronic single-neuron recording in freely behaving cats further revealed that cortical activity during rapid eye movement sleep resembled activity present during monocular deprivation. This corresponded to times of maximal extracellular signal–regulated kinase activation. These findings indicate that rapid eye movement sleep promotes molecular and network adaptations that consolidate waking experience in the developing brain.},
	number = {6},
	urldate = {2023-01-23},
	journal = {Science Advances},
	publisher = {American Association for the Advancement of Science},
	author = {Dumoulin Bridi, Michelle C. and Aton, Sara J. and Seibt, Julie and Renouard, Leslie and Coleman, Tammi and Frank, Marcos G.},
	month = jul,
	year = {2015},
	pages = {e1500105},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/8AW2BY8M/Dumoulin Bridi et al. - 2015 - Rapid eye movement sleep promotes cortical plastic.pdf:application/pdf},
}

@article{renouard_rem_2022,
	title = {{REM} sleep promotes bidirectional plasticity in developing visual cortex in vivo},
	volume = {12},
	issn = {2451-9944},
	url = {https://www.sciencedirect.com/science/article/pii/S2451994422000025},
	doi = {10.1016/j.nbscr.2022.100076},
	abstract = {Sleep is required for the full expression of plasticity during the visual critical period (CP). However, the precise role of rapid-eye-movement (REM) sleep in this process is undetermined. Previous studies in rodents indicate that REM sleep weakens cortical circuits following MD, but this has been explored in only one class of cortical neuron (layer 5 apical dendrites). We investigated the role of REM sleep in ocular dominance plasticity (ODP) in layer 2/3 neurons using 2-photon calcium imaging in awake CP mice. In contrast to findings in layer 5 neurons, we find that REM sleep promotes changes consistent with synaptic strengthening and weakening. This supports recent suggestions that the effects of sleep on plasticity are highly dependent upon the type of circuit and preceding waking experience.},
	language = {en},
	urldate = {2023-01-23},
	journal = {Neurobiology of Sleep and Circadian Rhythms},
	author = {Renouard, Leslie and Hayworth, Christopher and Rempe, Michael and Clegern, Will and Wisor, Jonathan and Frank, Marcos G.},
	month = may,
	year = {2022},
	keywords = {Development, Monocular deprivation, Ocular dominance plasticity, Ontogeny, Remodeling, Synapse},
	pages = {100076},
	file = {ScienceDirect Full Text PDF:/Users/karolina/Zotero/storage/BK73JYCY/Renouard et al. - 2022 - REM sleep promotes bidirectional plasticity in dev.pdf:application/pdf;ScienceDirect Snapshot:/Users/karolina/Zotero/storage/ILE4CH7K/S2451994422000025.html:text/html},
}

@article{wang_rem_2022,
	title = {{REM} sleep is associated with distinct global cortical dynamics and controlled by occipital cortex},
	volume = {13},
	copyright = {2022 The Author(s)},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-022-34720-9},
	doi = {10.1038/s41467-022-34720-9},
	abstract = {The cerebral cortex is spontaneously active during sleep, yet it is unclear how this global cortical activity is spatiotemporally organized, and whether such activity not only reflects sleep states but also contributes to sleep state switching. Here we report that cortex-wide calcium imaging in mice revealed distinct sleep stage-dependent spatiotemporal patterns of global cortical activity, and modulation of such patterns could regulate sleep state switching. In particular, elevated activation in the occipital cortical regions (including the retrosplenial cortex and visual areas) became dominant during rapid-eye-movement (REM) sleep. Furthermore, such pontogeniculooccipital (PGO) wave-like activity was associated with transitions to REM sleep, and optogenetic inhibition of occipital activity strongly promoted deep sleep by suppressing the NREM-to-REM transition. Thus, whereas subcortical networks are critical for initiating and maintaining sleep and wakefulness states, distinct global cortical activity also plays an active role in controlling sleep states.},
	language = {en},
	number = {1},
	urldate = {2023-01-23},
	journal = {Nature Communications},
	publisher = {Nature Publishing Group},
	author = {Wang, Ziyue and Fei, Xiang and Liu, Xiaotong and Wang, Yanjie and Hu, Yue and Peng, Wanling and Wang, Ying-wei and Zhang, Siyu and Xu, Min},
	month = nov,
	year = {2022},
	note = {Number: 1},
	keywords = {Neuroscience, REM sleep},
	pages = {6896},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/2UUZ5NKP/Wang et al. - 2022 - REM sleep is associated with distinct global corti.pdf:application/pdf},
}

@article{frank_sleep_2001,
	title = {Sleep {Enhances} {Plasticity} in the {Developing} {Visual} {Cortex}},
	volume = {30},
	issn = {0896-6273},
	url = {https://www.sciencedirect.com/science/article/pii/S0896627301002793},
	doi = {10.1016/S0896-6273(01)00279-3},
	abstract = {During a critical period of brain development, occluding the vision of one eye causes a rapid remodeling of the visual cortex and its inputs. Sleep has been linked to other processes thought to depend on synaptic remodeling, but a role for sleep in this form of cortical plasticity has not been demonstrated. We found that sleep enhanced the effects of a preceding period of monocular deprivation on visual cortical responses, but wakefulness in complete darkness did not do so. The enhancement of plasticity by sleep was at least as great as that produced by an equal amount of additional deprivation. These findings demonstrate that sleep and sleep loss modify experience-dependent cortical plasticity in vivo. They suggest that sleep in early life may play a crucial role in brain development.},
	language = {en},
	number = {1},
	urldate = {2023-01-23},
	journal = {Neuron},
	author = {Frank, Marcos G and Issa, Naoum P and Stryker, Michael P},
	month = apr,
	year = {2001},
	pages = {275--287},
	file = {Full Text:/Users/karolina/Zotero/storage/5YG543U8/Frank et al. - 2001 - Sleep Enhances Plasticity in the Developing Visual.pdf:application/pdf;ScienceDirect Snapshot:/Users/karolina/Zotero/storage/RP6XKE5D/S0896627301002793.html:text/html},
}

@article{igawa_activation_2001,
	title = {Activation of visual cortex in {REM} sleep measured by 24-channel {NIRS} imaging},
	volume = {55},
	issn = {1440-1819},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1046/j.1440-1819.2001.00819.x},
	doi = {10.1046/j.1440-1819.2001.00819.x},
	abstract = {To visualize dreaming brain functions we studied hemodynamic changes in the visual cortex during the transition from non-rapid eye movement (NREM) to rapid eye movement (REM) sleep, using a 24-channel Near-Infrared Spectroscopy (NIRS) imaging method. Results were compared to the activation in visual cortex by visual stimulation during wakefulness. Subjects were four healthy males between 25 and 49 years of age. Five all-night polysomnographic and NIRS recordings were made. Increases in the oxygenated hemoglobin concentration in visual cortex were observed from nine of 14 REM periods. The activated areas were broader during REM sleep than during visual stimulation. These findings suggest that activation of visual cortex in REM sleep might represent dream-related brain activity.},
	language = {en},
	number = {3},
	urldate = {2023-01-23},
	journal = {Psychiatry and Clinical Neurosciences},
	author = {Igawa, Mariko and Atsumi, Yoshikata and Takahashi, Kazumi and Shiotsuka, Shinichi and Hirasawa, Hideto and Yamamoto, Ryusei and Maki, Atsushi and Yamashita, Yuichi and Koizumi, Hideaki},
	year = {2001},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1046/j.1440-1819.2001.00819.x},
	keywords = {REM sleep, dreaming, EEG, mapping, NIRS, occipital, visual cortex},
	pages = {187--188},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/WHJE48U7/Igawa et al. - 2001 - Activation of visual cortex in REM sleep measured .pdf:application/pdf;Snapshot:/Users/karolina/Zotero/storage/4HRWCFYL/j.1440-1819.2001.00819.html:text/html},
