@article{denker_local_2011-1,
	title = {The {Local} {Field} {Potential} {Reflects} {Surplus} {Spike} {Synchrony}},
	volume = {21},
	issn = {1047-3211},
	url = {https://doi.org/10.1093/cercor/bhr040},
	doi = {10.1093/cercor/bhr040},
	abstract = {While oscillations of the local field potential (LFP) are commonly attributed to the synchronization of neuronal firing rate on the same time scale, their relationship to coincident spiking in the millisecond range is unknown. Here, we present experimental evidence to reconcile the notions of synchrony at the level of spiking and at the mesoscopic scale. We demonstrate that only in time intervals of significant spike synchrony that cannot be explained on the basis of firing rates, coincident spikes are better phase locked to the LFP than predicted by the locking of the individual spikes. This effect is enhanced in periods of large LFP amplitudes. A quantitative model explains the LFP dynamics by the orchestrated spiking activity in neuronal groups that contribute the observed surplus synchrony. From the correlation analysis, we infer that neurons participate in different constellations but contribute only a fraction of their spikes to temporally precise spike configurations. This finding provides direct evidence for the hypothesized relation that precise spike synchrony constitutes a major temporally and spatially organized component of the LFP.},
	number = {12},
	urldate = {2022-11-21},
	journal = {Cerebral Cortex},
	author = {Denker, Michael and Roux, Sébastien and Lindén, Henrik and Diesmann, Markus and Riehle, Alexa and Grün, Sonja},
	month = dec,
	year = {2011},
	pages = {2681--2695},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/CQ8BWI4M/Denker et al. - 2011 - The Local Field Potential Reflects Surplus Spike S.pdf:application/pdf;Snapshot:/Users/karolina/Zotero/storage/UJY7PFKB/294276.html:text/html},
}

@article{bressloff_theory_2010-2,
	title = {Theory for the alignment of cortical feature maps during development},
	volume = {82},
	url = {https://link.aps.org/doi/10.1103/PhysRevE.82.021920},
	doi = {10.1103/PhysRevE.82.021920},
	abstract = {We present a developmental model of ocular dominance column formation that takes into account the existence of an array of intrinsically specified cytochrome oxidase blobs. We assume that there is some molecular substrate for the blobs early in development, which generates a spatially periodic modulation of experience-dependent plasticity. We determine the effects of such a modulation on a competitive Hebbian mechanism for the modification of the feedforward afferents from the left and right eyes. We show how alternating left and right eye dominated columns can develop, in which the blobs are aligned with the centers of the ocular dominance columns and receive a greater density of feedforward connections, thus becoming defined extrinsically. More generally, our results suggest that the presence of periodically distributed anatomical markers early in development could provide a mechanism for the alignment of cortical feature maps.},
	number = {2},
	urldate = {2023-01-13},
	journal = {Physical Review E},
	publisher = {American Physical Society},
	author = {Bressloff, Paul C. and Oster, Andrew M.},
	month = aug,
	year = {2010},
	pages = {021920},
