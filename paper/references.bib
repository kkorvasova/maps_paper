@article{yang_sensory_2025-1,
	title = {Sensory {Encoding} {Alternates} {With} {Hippocampal} {Ripples} across {Cycles} of {Forebrain} {Spiking} {Cascades}},
	issn = {2198-3844, 2198-3844},
	url = {https://advanced.onlinelibrary.wiley.com/doi/10.1002/advs.202406224},
	doi = {10.1002/advs.202406224},
	abstract = {Abstract The brain's response to external events depends on its internal arousal states, which are dynamically governed by neuromodulatory systems and have recently been linked to coordinated spike timing cascades in widespread brain networks. At rest, both arousal fluctuations and spiking cascades are evident throughout the forebrain and play out over multisecond time scales. Here, by analyzing large‐scale neural recording data collected by the Allen Institute, it is demonstrated that these intrinsic processes persist across the mouse brain even during periods of continuous visual stimulation. In the stationary animal, each quasi‐periodic cascade cycle systematically influenced 1) the efficacy of encoding in visually responsive brain areas and 2) the incidence of memory‐related hippocampal ripples. During this cycle, the phase of high arousal is marked by high efficiency in visual encoding whereas the phase of low arousal is marked by the occurrence of hippocampal ripples. However, during bouts of active locomotion, this cycle is abolished and brain maintained a state of elevated visual coding efficiency, with ripples being nearly absent. It is hypothesized that the infra‐slow cascade dynamics reflect an adaptive cycle of alternating exteroceptive sensory sampling and internal mnemonic function that persistently pervades the forebrain, only stopping during active exploration of the environment.},
	language = {en},
	urldate = {2025-03-25},
	journal = {Advanced Science},
	author = {Yang, Yifan and Leopold, David A. and Duyn, Jeff H. and Sipe, Grayson O. and Liu, Xiao},
	month = feb,
	year = {2025},
	pages = {2406224},
	file = {PDF:/Users/karolina/Zotero/storage/XXJPC84L/Yang et al. - 2025 - Sensory Encoding Alternates With Hippocampal Ripples across Cycles of Forebrain Spiking Cascades.pdf:application/pdf},
}

@article{malovichko_pde-constrained_2024-2,
	title = {{PDE}-constrained {Optimization} for {Electroencephalographic} {Source} {Reconstruction}},
	volume = {45},
	issn = {1818-9962},
	url = {https://doi.org/10.1134/S1995080224603266},
	doi = {10.1134/S1995080224603266},
	abstract = {This paper introduces a novel numerical method for the inverse problem of electroencephalography (EEG). We pose the inverse EEG problem as an optimal control (OC) problem for Poisson’s equation. The optimality conditions lead to a variational system of differential equations. It is discretized directly in finite-element spaces leading to a system of linear equations with a sparse Karush–Kuhn–Tucker matrix. The method uses finite-element discretization and thus can handle MRI-based meshes of almost arbitrary complexity. It extends the well-known mixed quasi-reversibility method (mQRM) in that pointwise noisy data explicitly appear in the formulation making unnecessary tedious interpolation of the noisy data from the electrodes to the scalp surface. The resulting algebraic problem differs considerably from that obtained in the mixed quasi-reversibility, but only slightly larger. The algorithm does not require the formation of the lead-field matrix, which can be beneficial for large matrices. Our tests, both with spherical and MRI-based meshes, demonstrates that the method accurately reconstructs cortical activity.},
	language = {en},
	number = {6},
	urldate = {2024-11-19},
	journal = {Lobachevskii Journal of Mathematics},
	author = {Malovichko, M. S. and Yavich, N. B. and Razorenova, A. M. and Golubev, V. I. and Koshev, N. A.},
	month = jun,
	year = {2024},
	keywords = {electroencephalography, inverse problems, optimal control},
	pages = {2875--2894},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/3ND4Q6PB/Malovichko et al. - 2024 - PDE-constrained Optimization for Electroencephalographic Source Reconstruction.pdf:application/pdf},
}

@article{uher_cognitive_2018-1,
	title = {Cognitive clinico-radiological paradox in early stages of multiple sclerosis},
	volume = {5},
	copyright = {© 2017 The Authors. Annals of Clinical and Translational Neurology published by Wiley Periodicals, Inc on behalf of American Neurological Association.},
	issn = {2328-9503},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/acn3.512},
	doi = {10.1002/acn3.512},
	abstract = {Objective To investigate whether the strength of the association between magnetic resonance imaging (MRI) metrics and cognitive outcomes differs between various multiple sclerosis subpopulations. Methods A total of 1052 patients were included in this large cross-sectional study. Brain MRI (T1 and T2 lesion volume and brain parenchymal fraction) and neuropsychological assessment (Brief International Cognitive Assessment for Multiple Sclerosis and Paced Auditory Serial Addition Test) were performed. Results Weak correlations between cognitive domains and MRI measures were observed in younger patients (age≤30 years; absolute Spearman's rho = 0.05–0.21), with short disease duration ({\textbackslash}textless2 years; rho = 0.01–0.21), low Expanded Disability Status Scale [EDSS] (≤1.5; rho = 0.08–0.18), low T2 lesion volume (lowest quartile; {\textbackslash}textless0.59 mL; rho = 0.01–0.20), and high brain parenchymal fraction (highest quartile; {\textbackslash}textgreater86.66; rho = 0.01–0.16). Stronger correlations between cognitive domains and MRI measures were observed in older patients (age{\textbackslash}textgreater50 years; rho = 0.24–0.50), with longer disease duration ({\textbackslash}textgreater15 years; rho = 0.26–0.53), higher EDSS (≥5.0; rho = 0.23–0.39), greater T2 lesion volume (highest quartile; {\textbackslash}textgreater5.33 mL; rho = 0.16–0.32), and lower brain parenchymal fraction (lowest quartile; {\textbackslash}textless83.71; rho = 0.13–0.46). The majority of these observed results were confirmed by significant interactions (P ≤ 0.01) using continuous variables. Interpretation The association between structural brain damage and functional cognitive impairment is substantially weaker in multiple sclerosis patients with a low disease burden. Therefore, disease stage should be taken into consideration when interpreting associations between structural and cognitive measures in clinical trials, research studies, and clinical practice.},
	language = {en},
	number = {1},
	urldate = {2025-03-27},
	journal = {Annals of Clinical and Translational Neurology},
	author = {Uher, Tomas and Krasensky, Jan and Sobisek, Lukas and Blahova Dusankova, Jana and Seidl, Zdenek and Kubala Havrdova, Eva and Sormani, Maria Pia and Horakova, Dana and Kalincik, Tomas and Vaneckova, Manuela},
	year = {2018},
	pages = {81--91},
	annote = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/acn3.512},
	file = {Full Text PDF:/Users/karolina/Zotero/storage/8UPVXCBD/Uher et al. - 2018 - Cognitive clinico-radiological paradox in early stages of multiple sclerosis.pdf:application/pdf;Snapshot:/Users/karolina/Zotero/storage/CA27LKAC/acn3.html:text/html},
}

