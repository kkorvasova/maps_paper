@misc{noauthor_plasticity_nodate-2,
	title = {Plasticity in {Multiple} {Sclerosis}: {From} {Molecular} to {System} {Level}, from {Adaptation} to {Maladaptation}},
	shorttitle = {Plasticity in {Multiple} {Sclerosis}},
	url = {https://www.frontiersin.org/research-topics/3146/plasticity-in-multiple-sclerosis-from-molecular-to-system-level-from-adaptation-to-maladaptation/magazine},
	abstract = {Plasticity occurs at multiple levels in multiple sclerosis (MS), from cells to synapses, from myelin to axons, from individual regions to large-scale brain networks. A growing body of evidence supports the notion that the course of MS and its extremely heterogeneous clinical manifestations might be the net result of disease burden and compensatory capacity. As a consequence, identifying what can be considered as \&quot;positive\&quot; plasticity and what, on the contrary, is a maladaptive reorganization is a very attractive goal which might help to develop therapeutic strategies able to promote the individual adaptive capacity. The aim of this Research Topic forum is to provide a state of the art update on the diversity of available data in humans with MS, derived from the many studies performed using different research tools, including immunological, neurophysiological and neuroimaging techniques which have addressed neuroplasticity at multiple system level, from motor, to visual, and cognitive. Synopsis of recent advances of plasticity research in MS aims to broaden the view across systems and techniques and to stimulate further studies on this emerging topic.},
	language = {en},
	urldate = {2026-07-17},
	file = {Snapshot:/Users/karolina/Zotero/storage/6J6VKBLD/magazine.html:text/html},
}

