	pages = {620--627},
	annote = {Number: 5},
	file = {Submitted Version:/Users/karolina/Zotero/storage/KMSJIN24/Lobato-Rios et al. - 2022 - NeuroMechFly, a neuromechanical model of adult Dro.pdf:application/pdf},
}

