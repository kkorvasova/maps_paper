	month = nov,
	year = {2021},
	keywords = {anterior temporal lobe, episodic memory, ripple oscillations, single unit activity},
	pages = {e68401},
	file = {Full Text:/Users/karolina/Zotero/storage/P5RHTYIB/Tong et al. - 2021 - Ripples reflect a spectrum of synchronous spiking .pdf:application/pdf},
}

